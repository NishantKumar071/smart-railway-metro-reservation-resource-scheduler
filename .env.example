# SmartRail AI+ — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartrail_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ─── Application ───────────────────────────────────────────
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=3000

# ─── Security ──────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ─── AI Service ────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
MODEL_RETRAIN_INTERVAL_HOURS=24

# ─── Worker Threads (OS Concept) ───────────────────────────
WORKER_THREAD_COUNT=6
REQUEST_QUEUE_MAX_SIZE=100

# ─── Admin ─────────────────────────────────────────────────
ADMIN_EMAIL=admin@smartrail.local
ADMIN_PASSWORD=change_this_in_production

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/smartrail.log
